{
  // Matches what the modules actually require: the 10px top margin on
  // .modules-* plus #bluetooth's 10px vertical margin and the 14px text.
  // Setting this lower does nothing — waybar clamps up and warns.
  "height": 50,
  "layer": "top",
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/submap",
    "clock"
  ],
  "modules-center": [
    "hyprland/window",
    "tray"
  ],
  "modules-right": [
    "battery",
    "pulseaudio",
    "idle_inhibitor",
    "bluetooth",
    "network",
    "power-profiles-daemon"
  ],
  "custom/launcher": {
    "exec": "~/.local/share/my/bin/sys-get-os-icon",
    "format": "{}",
    "on-click": "rofi-launch-module ~/.config/rofi/modules/system.json"
  },
  "hyprland/window": {
    "max-length": 50
  },
  "clock": {
    "format": "{:L%A %I:%M %p}",
    "format-alt": "{:L%A %I:%M %p}"
  },
  "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "",
        "deactivated": ""
      },
      "timeout": 60.0,
      "start-activated": false,
      "tooltip": true,
      "tooltip-format-activated": "Idle inhibitor: ON\nScreen will not lock or sleep",
      "tooltip-format-deactivated": "Idle inhibitor: OFF\nNormal idle behavior active"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "", // an empty format will hide the module
    "format-connected": "",
    "tooltip-format": "Connections: {num_connections}\n\n{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "Connections: {num_connections}\n\n{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager"
  },
  "battery": {
    "interval": 60,
    "format": "{capacity}% {icon}",
    "tooltip-format": "Capacity: {capacity}\nPower (watts): {power}\nTime to charge: {time}",
    "format-icons": {
      "default": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "charging": [
        "󰢟",
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ]
    }
  },
  "network": {
    "format": "",
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "󰤭", //An empty format will hide the module.
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "󰖪",
    "max-length": 50,
    "on-click": "hypr-launch-tui nmtui"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

"pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": " Muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "sort-by-number": true,
    "format-icons": {
      "9": "",
      "10": "󰒃"
    },
    "persistent-workspaces": {
      "*": 5 // 5 workspaces by default on every monitor
    }
  },

  "tray": {
    "spacing": 10
  }
}
